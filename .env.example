# Copy this file to .env and fill it in. See SETUP.md for where each key comes from.
# Leave the Supabase lines empty to run in demo mode with sample data.

# --- Supabase (Project Settings > API) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Maps on phones (optional; Google Cloud Console > Credentials) ---
# Leave empty: iPhone shows Apple Maps and Android uses Expo Go's Google Maps.
# The web map uses OpenStreetMap and needs no key.
# Maps SDK for iOS / Android keys, used at build time only (development builds).
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=

# Secret keys (Instagram, TikTok, Google OAuth, Google Places) do NOT go here.
# They're stored in Supabase with `npx supabase secrets set` (see SETUP.md).
